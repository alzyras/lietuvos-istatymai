{"citation_group_id":"eab2bb7b7e68abda2cb5828e","citation_text":"šio straipsnio 2 dalį","confidence":1.0,"relation_type":"internal_reference","resolver":"internal_section","source_anchor":"^s-8783255fde8740342143f40d","source_etar_id":"64f3f470ff7711e78bcec397524184ce","source_excerpt":"1. Šis įstatymas, išskyrus šio straipsnio 2 dalį, įsigalioja 2018 m. balandžio 1 d.","source_link":"[[latest/64f3f470ff7711e78bcec397524184ce#^s-8783255fde8740342143f40d|3 str. 1 dalis]]","source_path":"latest/64f3f470ff7711e78bcec397524184ce.md","source_section_id":"8783255fde8740342143f40d","target_anchor":"^s-1692536c2c742a38b7bc7e13","target_etar_id":"64f3f470ff7711e78bcec397524184ce","target_link":"[[latest/64f3f470ff7711e78bcec397524184ce#^s-1692536c2c742a38b7bc7e13|3 str. 2 dalis]]","target_path":"latest/64f3f470ff7711e78bcec397524184ce.md","target_section_id":"1692536c2c742a38b7bc7e13"}
