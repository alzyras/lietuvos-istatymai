{"citation_group_id":"37c6aaca3417f914502b3699","citation_text":"šio straipsnio 5 dalyje","confidence":1.0,"relation_type":"internal_reference","resolver":"internal_section","source_anchor":"^s-5e274f3ba141562a7cf777a9","source_etar_id":"26de5df0e30d11ec8d9390588bf2de65","source_excerpt":"6. Kol dėl šio straipsnio 5 dalyje nurodytų aplinkybių embrionai laikomi lytinių ląstelių banke, kiti embrionai tos pačios moters pagalbiniam apvaisinimui negali būti kuriami.","source_link":"[[latest/26de5df0e30d11ec8d9390588bf2de65#^s-5e274f3ba141562a7cf777a9|9 str. 6 dalis]]","source_path":"latest/26de5df0e30d11ec8d9390588bf2de65.md","source_section_id":"5e274f3ba141562a7cf777a9","target_anchor":"^s-9b0146c9b44915dff0ea54ef","target_etar_id":"26de5df0e30d11ec8d9390588bf2de65","target_link":"[[latest/26de5df0e30d11ec8d9390588bf2de65#^s-9b0146c9b44915dff0ea54ef|9 str. 5 dalis]]","target_path":"latest/26de5df0e30d11ec8d9390588bf2de65.md","target_section_id":"9b0146c9b44915dff0ea54ef"}
